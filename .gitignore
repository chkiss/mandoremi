# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- The secret-bearing SQLite DB (never commit; generated at runtime) ---
# Holds user accounts, sessions, uploaded lyrics, and the analysis cache.
*.db
*.db-*
*.db.bak-*
*.sqlite
*.sqlite3

# --- Generated data, not source (regenerated by tools/*) ---
# user_dict.txt: built by tools/merge_chengyu.py from the chengyu set.
# leaderboard_snapshot.json: frozen numbers for the /artists article.
data/user_dict.txt
data/leaderboard_snapshot.json

# --- Public blog / Artist surface (intentionally excluded from this repo) ---
# app/public_pages.py wires the /artists, /artist/, /song/, /chengyu/ pages and
# the sitemap. Kept on disk for the production deploy; absent on a fresh clone,
# where main.py simply skips registering those routes.
#
# app/article.py is the writing itself -- the /artists post, and the author's
# name, bio and links. It is authored prose, not part of the analysis tool, so
# it belongs on the site and not in a public source repository. app/public.py
# imports it lazily and renders nothing at all when it is missing.
app/public_pages.py
app/article.py
static/img/

# --- editor / OS noise ---
.DS_Store
*.swp

# --- Deploy / host-specific tooling (kept local only, not in this repo) ---
# deploy.sh and tools/telemetry_report.py hardcode the production host;
# mandoremi.com.conf is the live nginx vhost. None belong in the public repo.
deploy.sh
tools/telemetry_report.py
mandoremi.com.conf
